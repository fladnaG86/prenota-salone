# Copy to barberia.env (chmod 600) and set real values. Never commit secrets.

# --- required in production ---
BARBERIA_PANEL_SECRET=change-me-long-random-string
BARBERIA_ADMIN_TOKEN=change-me-long-random-string

# --- optional: listen port / file paths ---
# BARBERIA_PORT=8899
# BARBERIA_HOST=0.0.0.0
# BARBERIA_DB_PATH=./bookings.db
# BARBERIA_LOG_PATH=./server.log
# BARBERIA_SALONS_JSON=./salons.json
# BARBERIA_PANEL_USERS=./panel_users.json
# BARBERIA_OG_DIR=./og

# --- optional: outgoing email (booking confirmation + .ics + ricevute) ---
# BARBERIA_SMTP_HOST=smtp.example.com
# BARBERIA_SMTP_PORT=587
# BARBERIA_SMTP_LOGIN=you@yourdomain.com
# BARBERIA_SMTP_PASSWORD=...

# --- optional: ricevuta di avvenuta prestazione ---
# La ricevuta parte in automatico quando la prestazione viene chiusa dal
# pannello. Con BARBERIA_AUTO_RECEIPT=1 un worker chiude da solo le
# prenotazioni terminate (utile per non toccare nulla durante il lavoro).
# BARBERIA_AUTO_RECEIPT=0
# BARBERIA_AUTO_RECEIPT_GRACE_MIN=15

# --- optional: 301 redirects for renamed subdomains ---
# BARBERIA_SLUG_REDIRECTS={"old-slug":"new-slug"}
